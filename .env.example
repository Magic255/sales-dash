FLASK_ENV=development
APP_ENV=development
SECRET_KEY=replace-this-with-a-long-random-local-secret
HOST=127.0.0.1
PORT=5000

# Database administrator: migrations and the one-time create-admin command only.
DATABASE_URL=postgresql+psycopg://sales_dash:sales_dash_dev@127.0.0.1:5432/sales_dash
ADMIN_DATABASE_URL=postgresql+psycopg://sales_dash:sales_dash_dev@127.0.0.1:5432/sales_dash

# Web application: create this login and grant it membership in sales_dash_app.
APP_DATABASE_URL=postgresql+psycopg://sales_dash_runtime:replace-this-password@127.0.0.1:5432/sales_dash

# Use Redis in production; memory:// is for local development only.
RATELIMIT_STORAGE_URI=memory://

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
